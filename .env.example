# =============================================================
# Copy to .env and fill in the values:   cp .env.example .env
# .env is git-ignored; never commit real credentials.
# Local defaults below work as-is with docker-compose, except Snowflake.
# =============================================================

# --- PostgreSQL (source OLTP database) -----------------------
# Used by scripts running on your machine (generator), hence localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Host Debezium (inside Docker) uses to reach PostgreSQL — keep "postgres"
DEBEZIUM_DB_HOST=postgres

# --- Airflow ---------------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_DB_NAME=airflow
# Web UI account created by the airflow-init service
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# --- Kafka (consumer running on your machine) ----------------
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_GROUP=banking-consumer
# Optional: flush to MinIO every N records or every N seconds
# CONSUMER_BATCH_SIZE=500
# CONSUMER_FLUSH_SECONDS=30

# --- MinIO (S3-compatible landing zone) ----------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio-admin
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET=raw

# --- Snowflake -------------------------------------------------
# Account identifier: ORGNAME-ACCOUNTNAME (Snowsight > Account > View account details)
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=change-me
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DB=BANKING
SNOWFLAKE_SCHEMA=RAW

# --- Jupyter (ML notebooks) -----------------------------------
# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(16))"
JUPYTER_TOKEN=change-me
